{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Client Outputs",
    "description": "Schema defining the output of the data contents",
    "type": "object",
    "properties":
        {
            "created on":
                {
                    "description": "The timestamp of when the report was created",
                    "type": "string"
                },
            "model id":
                {
                    "description": "The id of the model trained",
                    "type": "integer"
                },
            "partitions file":
                {
                    "description": "The file used to partition the data for training",
                    "type": "string"
                },
            "train accuracy":
                {
                    "description": "Training accuracy for this client and round",
                    "type": "number"
                },
            "test accuracy":
                {
                    "description": "Test accuracy for this client and round",
                    "type": "number"
                },
            "train mean squared error":
                {
                    "description": "Train MSE for this client and round",
                    "type": "number"
                },
            "test mean squared error":
                {
                    "description": "Test MSE for this client and round",
                    "type": "number"
                },
            "train loss":
                {
                    "description": "Train loss for this client and round",
                    "type": "number"
                },
            "test loss":
                {
                    "description": "Test loss for this client and round",
                    "type": "number"
                },
            "train indices":
                {
                    "description": "Indices used for training",
                    "type": "array",
                    "items": 
                        {
                            "type": "integer"
                        }
                },
            "test indices":
                {
                    "description": "Indices used for testing",
                    "type": "array",
                    "items": 
                        {
                            "type": "integer"
                        }
                },
            "train accuracy per epoch":
                {
                    "description": "Accuracy over epochs for training",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "test accuracy per epoch":
                {
                    "description": "Accuracy over epochs for testing",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "train mse per epoch":
                {
                    "description": "MSE over epochs for training",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "Test mse per epoch":
                {
                    "description": "MSE over epochs for testing",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "losses per epoch":
                {
                    "description": "Loss values for each epoch in this client round",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "epsilon per epoch":
                {
                    "description": "The epsilon values for each epoch in this client round",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "train predictions":
                {
                    "description": "The predicted values for the training set",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "test predictions":
                {
                    "description": "The predicted values for the test set",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "hyperparameters": 
                {
                    "description": "The hyperparameters the client used during its training process",
                    "type": "object",
                    "properties": 
                        {
                            "learning rate":
                                {
                                    "description": "Sets the model's learning rate. This defines how much a model changes at each iteration",
                                    "type": "number"
                                },
                            "weight decay":
                                {
                                    "description": "Sets the model's weight decay. This is a regularization method that penalizes high weights",
                                    "type": "number"
                                },
                            "batch divisor":
                                {
                                    "description": "The divisor to determine the number of batches (num_batches = dataset_size/batch_divisor) -- I can only check this after loading in the dataset, not in the json",
                                    "type": "integer"
                                },
                            "epochs":
                                {
                                    "description": "The number of model training epochs. An epoch is one full pass through a training dataset",
                                    "type": "integer"
                                },
                            "seed":
                                {
                                    "description": "The seed used to randomize training/testing",
                                    "type": "integer"
                                },
                            "test fraction":
                                {
                                    "description": "The fraction of the data set to set aside for testing",
                                    "type": "number"
                                },
                            "accuracy tolerance":
                                {
                                    "description": "Error tolerance to declare prediction as correct",
                                    "type": "number"
                                },
                            "optimizer":
                                {
                                    "description": "The optimizer is responsible for adjusting model parameters based on the value of the loss function",
                                    "type": "string"
                                },
                            "epsilon":
                                {
                                    "description": "Determines the amount of privacy added to the data. ",
                                    "type": "number"
                                },
                            "delta":
                                {
                                    "description": "Measures the chance of a data breach. It defines the probability of the noise not adding sufficient privacy",
                                    "type": "number"
                                },
                            "max grad norm": 
                                {
                                    "description": "Clips the gradients to be under this maximum before adding noise",
                                    "type": "number"
                                }
                        }
                }
        }
}