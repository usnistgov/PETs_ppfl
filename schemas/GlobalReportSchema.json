{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Global (Server) Outputs",
    "description": "Schema defining the output of the data contents",
    "type": "object",
    "properties":
        {
            "created on":
                {
                    "description": "The timestamp of when the report was created",
                    "type": "string"
                },
            "loss per round":
                {
                    "description": "Loss values across rounds",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "accuracy per round":
                {
                    "description": "Accuracy values across rounds",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                },
            "mse per round":
                {
                    "description": "MSE values across rounds",
                    "type": "array",
                    "items": 
                        {
                            "type": "number"
                        }
                }
        }
}