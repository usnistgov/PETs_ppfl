{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Global Regression Outputs",
    "description": "Schema defining the output of regression global reports",
    "type": "object",
    "properties":
        {
            "created on":
                {
                    "description": "The timestamp of when the report was created",
                    "type": "string"
                },
            "problem type":
                {
                    "description": "The modeling problem type",
                    "const": "regression"
                },
            "accuracy tolerance":
                {
                    "description": "Error tolerance to declare a regression prediction as correct",
                    "type": "number"
                },
            "loss per round":
                {
                    "description": "Loss values across rounds",
                    "$ref": "#/$defs/numberArray"
                },
            "accuracy per round":
                {
                    "description": "Accuracy values across rounds",
                    "$ref": "#/$defs/numberArray"
                },
            "mse per round":
                {
                    "description": "MSE values across rounds",
                    "$ref": "#/$defs/numberArray"
                }
        },
    "$defs":
        {
            "numberArray":
                {
                    "type": "array",
                    "items": {"type": "number"}
                }
        }
}
