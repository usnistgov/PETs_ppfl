{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Global Classification Outputs",
    "description": "Schema defining the output of classification global reports",
    "type": "object",
    "properties":
        {
            "created on":
                {
                    "description": "The timestamp of when the report was created",
                    "type": "string"
                },
            "problem type":
                {
                    "description": "The modeling problem type",
                    "const": "classification"
                },
            "class labels":
                {
                    "description": "Allowed class labels for classification tasks",
                    "type": "array",
                    "items": {"type": ["string", "number", "boolean"]},
                    "minItems": 2
                },
            "loss per round":
                {
                    "description": "Loss values across rounds",
                    "$ref": "#/$defs/numberArray"
                },
            "accuracy per round":
                {
                    "description": "Accuracy values across rounds",
                    "$ref": "#/$defs/numberArray"
                },
            "precision macro per round":
                {
                    "description": "Macro-averaged precision values across rounds",
                    "$ref": "#/$defs/numberArray"
                },
            "recall macro per round":
                {
                    "description": "Macro-averaged recall values across rounds",
                    "$ref": "#/$defs/numberArray"
                }
        },
    "$defs":
        {
            "numberArray":
                {
                    "type": "array",
                    "items": {"type": "number"}
                }
        }
}
